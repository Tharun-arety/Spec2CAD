        "script": "\"\"\"Generated by spec2cad from a typed CADProgram.\n\npart:     blower_transition_duct\nrevision: DesignIntent v2\n\nThis file is produced for review. The pipeline does not execute it -- the\nexecutor builds from the typed feature plan directly.\n\"\"\"\n\nimport cadquery as cq\nimport math\n\n# --- parameters, resolved from DesignIntent ---\nduct_inlet_height = 60\nduct_inlet_width = 100\nduct_outlet_diameter = 80\nflange_width = 8\ntransition_length = 120\nwall_thickness = 2.5\n\n# --- feature plan ---\n# moulded_transition: thin-wall rectangle-to-round transition\ninlet_w = duct_inlet_width\ninlet_h = duct_inlet_height\noutlet_d = duct_outlet_diameter\ntransition_l = transition_length\nwall_t = wall_thickness\nflange_w = flange_width\nouter = cq.Workplane('XY').rect(inlet_w, inlet_h).workplane(offset=transition_l).circle(outlet_d/2).loft(combine=False)\ninner = (cq.Workplane('XY').workplane(offset=-1).rect(inlet_w-2*wall_t, inlet_h-2*wall_t)\n         .workplane(offset=transition_l+2).circle(outlet_d/2-wall_t).loft(combine=False))\nresult = outer.cut(inner)\ninlet_flange = (cq.Workplane('XY').box(inlet_w+2*flange_w, inlet_h+2*flange_w, 5, centered=(True,True,False))\n                .cut(cq.Workplane('XY').workplane(offset=-1).box(inlet_w-2*wall_t, inlet_h-2*wall_t, 7, centered=(True,True,False))))\noutlet_flange = (cq.Workplane('XY').workplane(offset=transition_l).circle(outlet_d/2+flange_w).extrude(5)\n                 .cut(cq.Workplane('XY').workplane(offset=transition_l-1).circle(outlet_d/2-wall_t).extrude(7)))\nresult = result.union(inlet_flange).union(outlet_flange)\n\n# cq.exporters.export(result.val(), 'part.step')\n"
      }
