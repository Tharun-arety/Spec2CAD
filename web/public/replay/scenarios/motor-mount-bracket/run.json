        "script": "\"\"\"Generated by spec2cad from a typed CADProgram.\n\npart:     adjustable_motor_mount_bracket\nrevision: DesignIntent v1\n\nThis file is produced for review. The pipeline does not execute it -- the\nexecutor builds from the typed feature plan directly.\n\"\"\"\n\nimport cadquery as cq\nimport math\n\n# --- parameters, resolved from DesignIntent ---\nbase_depth = 60\nbase_thickness = 8\nbracket_width = 38\nface_height = 60\ngusset_thickness = 5\nmotor_spacing = 31\nmounting_hole_diameter = 4.5\nshaft_hole_diameter = 24\nslot_length = 28\nslot_width = 8\n\n# --- feature plan ---\n# gusseted_motor_bracket: gusseted NEMA motor bracket\nbracket_width = bracket_width\nbase_depth = base_depth\nbase_t = base_thickness\nface_height = face_height\nmotor_spacing = motor_spacing\nmount_hole_d = mounting_hole_diameter\nshaft_hole_d = shaft_hole_diameter\nbase = cq.Workplane('XY').box(bracket_width, base_depth, base_t, centered=(True, True, False))\nwall_y = base_depth/2 - base_t/2\nwall = (cq.Workplane('XY').box(bracket_width, base_t, face_height+.5, centered=(True,True,False))\n        .translate((0, wall_y, base_t-.5)))\nresult = base.union(wall)\nface_z = base_t + face_height/2\ncutters = [cq.Solid.makeCylinder(shaft_hole_d/2, 4*base_t, cq.Vector(0, base_depth/2-2*base_t, face_z), cq.Vector(0,1,0))]\nfor x in (-motor_spacing/2, motor_spacing/2):\n    for z in (face_z-motor_spacing/2, face_z+motor_spacing/2):\n        cutters.append(cq.Solid.makeCylinder(mount_hole_d/2, 4*base_t, cq.Vector(x, base_depth/2-2*base_t, z), cq.Vector(0,1,0)))\nfor cutter in cutters: result = result.cut(cq.Workplane(obj=cutter))\nresult = result.faces('>Z').workplane().pushPoints([(-bracket_width*.28, -base_depth*.2), (bracket_width*.28, -base_depth*.2)]).slot2D(slot_length, slot_width, 90).cutThruAll()\n\n# cq.exporters.export(result.val(), 'part.step')\n"
      },
