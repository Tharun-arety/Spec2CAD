        "script": "\"\"\"Generated by spec2cad from a typed CADProgram.\n\npart:     flanged_shaft_coupling\nrevision: DesignIntent v1\n\nThis file is produced for review. The pipeline does not execute it -- the\nexecutor builds from the typed feature plan directly.\n\"\"\"\n\nimport cadquery as cq\nimport math\n\n# --- parameters, resolved from DesignIntent ---\nbolt_circle_diameter = 60\nbolt_hole_diameter = 6.6\nbore_diameter = 20\nentry_chamfer = 1\nflange_diameter = 80\nflange_thickness = 10\nhub_diameter = 40\nhub_length = 35\nkeyway_depth = 3\nkeyway_width = 6\nset_screw_depth = 0\n\n# --- feature plan ---\n# coupling_half: keyed rigid-coupling half\nflange_d = flange_diameter\nflange_t = flange_thickness\nhub_d = hub_diameter\nhub_l = hub_length\nbore_d = bore_diameter\nbolt_circle = bolt_circle_diameter\nbolt_d = bolt_hole_diameter\nkey_w = keyway_width\nkey_d = keyway_depth\nset_screw_depth = set_screw_depth\nresult = (cq.Workplane('XY').circle(flange_d / 2).extrude(flange_t)\n          .union(cq.Workplane('XY').workplane(offset=flange_t).circle(hub_d / 2).extrude(hub_l)))\nresult = result.cut(cq.Workplane('XY').workplane(offset=-1).circle(bore_d / 2).extrude(flange_t + hub_l + 2))\nkeyway = (cq.Workplane('XY').workplane(offset=-1).center(0, bore_d / 2 + key_d / 2)\n          .rect(key_w, key_d).extrude(flange_t + hub_l + 2))\nresult = result.cut(keyway)\nbolt_points = [(bolt_circle / 2 * math.cos(2 * math.pi * i / 4),\n                bolt_circle / 2 * math.sin(2 * math.pi * i / 4)) for i in range(4)]\nresult = result.faces('>Z').workplane().pushPoints(bolt_points).hole(bolt_d)\nif set_screw_depth > 0:\n    set_screw = cq.Solid.makeCylinder(2.1, set_screw_depth + .2, cq.Vector(hub_d/2 + .1, 0, flange_t + hub_l/2), cq.Vector(-1,0,0))\n    result = result.cut(cq.Workplane(obj=set_screw))\n\n# cq.exporters.export(result.val(), 'part.step')\n"
      },
