        "script": "\"\"\"Generated by spec2cad from a typed CADProgram.\n\npart:     sheet_metal_controller_enclosure\nrevision: DesignIntent v1\n\nThis file is produced for review. The pipeline does not execute it -- the\nexecutor builds from the typed feature plan directly.\n\"\"\"\n\nimport cadquery as cq\nimport math\n\n# --- parameters, resolved from DesignIntent ---\ncable_gland_diameter = 0\ncutout_position = 0\nenclosure_height = 40\nenclosure_length = 120\nenclosure_width = 80\nsheet_thickness = 1.5\n\n# --- feature plan ---\n# folded_enclosure: open-top constant-thickness controller enclosure\nlength = enclosure_length\nwidth = enclosure_width\nheight = enclosure_height\nsheet_t = sheet_thickness\ncable_gland_x = cutout_position\ncable_gland_d = cable_gland_diameter\nouter = cq.Workplane('XY').box(length, width, height, centered=(True, True, False))\ncavity = (cq.Workplane('XY').workplane(offset=sheet_t)\n          .box(length - 2*sheet_t, width - 2*sheet_t, height + 1, centered=(True, True, False)))\nresult = outer.cut(cavity)\ndisplay = cq.Workplane('XY').box(44, 2*sheet_t + 2, 18).translate((0, -width/2, height*.58))\nresult = result.cut(display)\nif cable_gland_d > 0:\n    gland = cq.Solid.makeCylinder(cable_gland_d/2, 2*sheet_t + 2, cq.Vector(cable_gland_x, -width/2 - 1, 16), cq.Vector(0,1,0))\n    result = result.cut(cq.Workplane(obj=gland))\n\n# cq.exporters.export(result.val(), 'part.step')\n"
      },
