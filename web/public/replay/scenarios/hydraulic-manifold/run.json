        "script": "\"\"\"Generated by spec2cad from a typed CADProgram.\n\npart:     hydraulic_manifold\nrevision: DesignIntent v1\n\nThis file is produced for review. The pipeline does not execute it -- the\nexecutor builds from the typed feature plan directly.\n\"\"\"\n\nimport cadquery as cq\nimport math\n\n# --- parameters, resolved from DesignIntent ---\nblock_height = 30\nblock_length = 100\nblock_width = 60\npassage_diameter = 8\nport_major_diameter = 12\nport_minor_diameter = 10.2\nport_pitch = 1.5\nport_spacing = 40\ntapping_depth = 14\n\n# --- feature plan ---\n# cross_drilled_manifold: threaded ports and connected cross-drillings\nblock_l = block_length\nblock_w = block_width\nblock_h = block_height\nport_major = port_major_diameter\nport_minor = port_minor_diameter\nport_pitch = port_pitch\ntap_depth = tapping_depth\npassage_d = passage_diameter\nport_spacing = port_spacing\nresult = cq.Workplane('XY').box(block_l, block_w, block_h)\nfor x in (-port_spacing/2, port_spacing/2):\n    bore = cq.Workplane('XY').workplane(offset=block_h/2-tap_depth).center(x,0).circle(port_minor/2).extrude(tap_depth+.5)\n    helix = cq.Wire.makeHelix(port_pitch, tap_depth, port_minor/2).translate(cq.Vector(x,0,block_h/2-tap_depth))\n    thread_profile = (cq.Workplane('XZ').transformed(offset=(x,0,block_h/2-tap_depth))\n                      .moveTo(port_minor/2,0).lineTo(port_major/2+.2,-port_pitch*.3)\n                      .lineTo(port_major/2+.2,port_pitch*.3).close())\n    result = result.cut(bore.union(thread_profile.sweep(cq.Workplane(obj=helix), isFrenet=True)))\n\n# cq.exporters.export(result.val(), 'part.step')\n"
      }
