{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install && VITE_API_BASE=https://spec2cad-api.onrender.com VITE_REPLAY_FALLBACK=1 npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "echo 'dependencies are installed by buildCommand'",
  "framework": null,
  "headers": [
    {
      "source": "/replay/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/replay/artifacts/(.*).step",
      "headers": [{ "key": "Content-Type", "value": "application/step" }]
    }
  ]
}
