# Copy to .env.local and fill in whichever you have. Both are optional: with neither,
# sketch extraction replays the recorded fixture and every row in the UI is
# labelled `recorded_fixture`. Datasheet and requirement extraction are real
# either way.

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# SPEC2CAD_VISION_BACKEND=auto        # auto | openai | anthropic | fixture
# SPEC2CAD_OPENAI_MODEL=gpt-4o
# SPEC2CAD_REASONING_MODEL=gpt-4o     # defaults to SPEC2CAD_OPENAI_MODEL
# SPEC2CAD_ANTHROPIC_MODEL=claude-sonnet-5
# Comma-separated extra HTTPS hosts accepted for user-supplied OpenAI-compatible
# endpoints. Common public providers are built in; keep this list exact because
# the API makes server-side requests to these hosts.
# SPEC2CAD_ALLOWED_MODEL_HOSTS=models.example.com

# Public API guardrails (safe demo defaults)
# SPEC2CAD_REQUESTS_PER_MINUTE=8
# SPEC2CAD_AI_UNITS_PER_CLIENT_DAY=12
# SPEC2CAD_AI_UNITS_GLOBAL_DAY=120
# SPEC2CAD_MAX_CONCURRENT_JOBS=1
# SPEC2CAD_JOB_QUEUE_TIMEOUT_MS=50
# SPEC2CAD_MAX_CACHED_RUNS=8
# SPEC2CAD_MAX_REQUIREMENT_CHARS=6000
# SPEC2CAD_MAX_CONVERSATION_MESSAGES=12
# SPEC2CAD_MAX_IMAGE_BYTES=5242880
# SPEC2CAD_MAX_PDF_BYTES=10485760
# SPEC2CAD_MAX_REQUEST_BYTES=12582912
# SPEC2CAD_MODEL_MAX_OUTPUT_TOKENS=3000
# SPEC2CAD_MODEL_TIMEOUT_SECONDS=35
# SPEC2CAD_USAGE_SALT=replace-with-a-random-secret
# SPEC2CAD_ADMIN_TOKEN=replace-with-a-random-secret
# SPEC2CAD_TRUST_PROXY=0
# SPEC2CAD_ALLOW_VERCEL_PREVIEWS=0
